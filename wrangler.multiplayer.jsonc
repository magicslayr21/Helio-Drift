{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "helio-drift-multiplayer",
  "main": "multiplayer/worker.mjs",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "MULTIPLAYER_ORIGINS": "https://magicslayr21.github.io,http://localhost:5173",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "helio-drift-leaderboard",
      "database_id": "c561c15b-1901-41d7-aac6-cc2628ad9b97",
      "migrations_dir": "worker/migrations",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MATCH_ROOMS",
        "class_name": "MatchRoom",
      },
      {
        "name": "LOBBY_INDEX",
        "class_name": "LobbyIndex",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MatchRoom"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["LobbyIndex"],
    },
  ],
}
